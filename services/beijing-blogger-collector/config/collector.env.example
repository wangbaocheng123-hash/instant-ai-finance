BLOGGER_AGENT_ROLE=collector
BLOGGER_AGENT_ENV_FILE=/var/lib/blogger-agent/config/collector.env
BLOGGER_AGENT_DATA_DIR=/var/lib/blogger-agent/data
BLOGGER_AGENT_CONFIG_DIR=/var/lib/blogger-agent/config
BLOGGER_AGENT_MEDIA_DIR=/var/lib/blogger-agent/media
BLOGGER_AGENT_DATABASE_PATH=/var/lib/blogger-agent/data/collector.sqlite3
BLOGGER_AGENT_CREATORS_PATH=/var/lib/blogger-agent/config/creators.json
BLOGGER_AGENT_ROTATION_SLOT_SECONDS=600
BLOGGER_AGENT_COLLECTOR_NODE_ID=beijing-collector-1
BLOGGER_AGENT_OUTBOX_PATH=/var/lib/blogger-agent/outbox/transfer.sqlite3
BLOGGER_AGENT_OUTBOX_ARTIFACT_DIR=/var/lib/blogger-agent/outbox/artifacts
BLOGGER_AGENT_OUTBOX_LEASE_SECONDS=1800
BLOGGER_AGENT_SENDER_INTERVAL_SECONDS=15
BLOGGER_AGENT_SENDER_BATCH_SIZE=10
BLOGGER_AGENT_SINGAPORE_BASE_URL=
BLOGGER_AGENT_TRANSFER_KEY_ID=
# 在 Git 外的 collector.env 中填写至少 32 字节密钥的十六进制编码（至少 64 个 hex 字符）。
BLOGGER_AGENT_TRANSFER_SECRET_HEX=
# 只读桥接原模型下载器；复用上面的签名通道，不启动浏览器或 AI。
MODEL_DOWNLOADER_BRIDGE_ENABLED=1
MODEL_DOWNLOADER_DATABASE=/var/lib/model-downloader/library.sqlite3
MODEL_DOWNLOADER_MEDIA_ROOT=/srv/model-downloader/videos
MODEL_DOWNLOADER_BRIDGE_INTERVAL_SECONDS=15
MODEL_DOWNLOADER_BRIDGE_STATE_PATH=/var/lib/blogger-agent/outbox/model-mr-bridge-state.json
