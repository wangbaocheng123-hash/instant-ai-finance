[Unit]
Description=Instant AI personal finance news collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=instantai
Group=instantai
WorkingDirectory=/opt/instant-ai/product
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/instant-ai/product
Environment=INSTANT_AI_LIBRARY_ROOT=/var/lib/instant-ai
ExecStart=/usr/bin/python3 -c "from instant_ai.server import run_server; run_server()"
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/instant-ai

[Install]
WantedBy=multi-user.target
