#!/usr/bin/env bash
set -Eeuo pipefail

[[ "$(id -u)" -eq 0 ]] || {
  printf 'beijing-suite-publish: root execution required\n' >&2
  exit 1
}
[[ "$#" -eq 0 ]] || {
  printf 'beijing-suite-publish: arguments are not accepted\n' >&2
  exit 2
}

systemctl start blogger-collector-git-deploy.service
[[ "$(systemctl show blogger-collector-git-deploy.service -p Result --value)" == "success" ]] || {
  printf 'beijing-suite-publish: blogger collector deployment failed\n' >&2
  exit 1
}

/usr/local/sbin/model-downloader-git-deploy
printf 'BEIJING_COLLECTION_SUITE_PUBLISH_VERIFIED\n'
